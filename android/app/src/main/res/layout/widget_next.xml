<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/widget_bg">
    <TextView
        android:id="@+id/w_head"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="NEXT UP" android:textColor="#FFF2B654" android:textSize="10sp"
        android:textStyle="bold" android:letterSpacing="0.12"/>
    <TextView
        android:id="@+id/w_now"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" android:text="Open the app once to load your plan"/>
    <TextView
        android:id="@+id/w_1"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#F2FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
    <TextView
        android:id="@+id/w_2"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#DDFFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
    <TextView
        android:id="@+id/w_3"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#BBFFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
