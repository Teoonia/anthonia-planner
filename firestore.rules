rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person can only read and write their own planner.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Pods couple app: a pod belongs to the (at most two) people in its members map.
    function isMember(podId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.members;
    }
    match /pods/{podId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      // Create a new pod with only yourself in it.
      allow create: if request.auth != null
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.createdBy == request.auth.uid;
      // Members can update; the second person can add only themselves, once.
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || (resource.data.members.size() < 2
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]))
      );
      match /{document=**} {
        allow read, write: if isMember(podId);
      }
    }
  }
}
